<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>Quickstart Services</description>
    <vendor></vendor>
    <version>1.0</version>

    <service name="noSyntaxError" engine="interface">
        <description>
            Dummy service to prevent empty files and syntax error - Remove when the 1st real service will be added here 
        </description>
    </service> 
    
    <service name="getDatabaseConfig" engine="groovy"
            location="component://quickstart/groovyScripts/GetDatabaseConfig.groovy" invoke="getDatabaseConfig">
        <description>Get database configuration as JSON</description>
        <attribute name="datasourceName" type="String" mode="IN" optional="true" />
        <attribute name="configJson" type="String" mode="OUT" optional="false"/>
        <attribute name="configMap" type="Map" mode="OUT" optional="false"/>
    </service>

    <service name="getSegmentedTime" engine="groovy" location="component://quickstart/groovyScripts/GetSegmentedTime.groovy" invoke="">
        <description>Renvoie l'heure actuelle segmentée en JSON</description>
        <attribute name="timeData" type="Map" mode="OUT" optional="false"/>
    </service>
    <service name="getDatabaseConfigData" engine="groovy" location="component://quickstart/groovyScripts/DatabaseConfigServices.groovy" invoke="getDatabaseConfigData">
        <description>Récupère la liste des datasources et des types de champs du fichier entityengine.xml</description>
        <attribute name="datasources" type="List" mode="OUT" optional="false"/>
        <attribute name="fieldTypes" type="List" mode="OUT" optional="false"/>
    </service>
    <service name="updateEntityEngineXml" engine="groovy" location="component://quickstart/groovyScripts/DatabaseConfigServices.groovy" invoke="updateEntityEngineXml">
        <attribute name="datasourceName" type="String" mode="IN"/>
        <attribute name="fieldType" type="String" mode="IN"/>
        <attribute name="jdbcUri" type="String" mode="IN"/>
        <attribute name="jdbcUsername" type="String" mode="IN"/>
        <attribute name="jdbcPassword" type="String" mode="IN" optional="true"/>
        <attribute name="jdbcDriver" type="String" mode="IN"/>
    </service>
    <service name="restartOfbiz" engine="groovy" location="component://quickstart/groovyScripts/DatabaseConfigServices.groovy" invoke="restartOfbiz">
    </service>
    <service name="createSuperUser" engine="groovy"
             location="component://quickstart/groovyScripts/CreateSuperUser.groovy"
             invoke="createSuperUser">
        <description>Créer un superutilisateur avec accès complet</description>
        <attribute name="userLoginId" type="String" mode="IN" optional="false"/>
        <attribute name="password" type="String" mode="IN" optional="false"/>
        <attribute name="firstName" type="String" mode="IN" optional="true"/>
        <attribute name="lastName" type="String" mode="IN" optional="true"/>
        <attribute name="emailAddress" type="String" mode="IN" optional="true"/>
    </service>

</services>
